---
interface Props {
  title: string;
  href: string;
  tag?: string;
  summary?: string;
  buttonText?: string;
  icon?: string;
  bgColor?: 'surface' | 'secondary' | 'accent';
}

const { 
  title, 
  href, 
  tag, 
  summary, 
  buttonText = "View Details", 
  icon = "📄",
  bgColor = "surface" 
} = Astro.props;
---

<div class={`featured-content-card bg-${bgColor}`}>
  <div class="card-icon">{icon}</div>
  <div class="card-content">
    {tag && <div class="card-tag">{tag}</div>}
    <h3 class="card-title">{title}</h3>
    {summary && <p class="card-summary">{summary}</p>}
  </div>
  <a href={href} class="btn btn-secondary card-btn">{buttonText}</a>
</div>

<style>
  .featured-content-card {
    border-radius: var(--radius-lg);
    padding: var(--spacing-xl);
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: all var(--transition-fast);
    border: 1px solid var(--color-border);
  }
  
  .bg-surface {
    background: var(--color-surface);
  }
  
  .bg-secondary {
    background: var(--color-bg-secondary);
  }
  
  .bg-accent {
    background: color-mix(in srgb, var(--color-accent-primary) 5%, transparent);
    border-color: color-mix(in srgb, var(--color-accent-primary) 20%, transparent);
  }
  
  .featured-content-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  
  .card-icon {
    font-size: 2.5rem;
    margin-bottom: var(--spacing-md);
  }
  
  .card-content {
    flex-grow: 1;
    margin-bottom: var(--spacing-lg);
  }
  
  .card-tag {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent-primary);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  
  .card-title {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
    color: var(--color-text-primary);
  }
  
  .card-summary {
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }
  
  .card-btn {
    align-self: flex-start;
    margin-top: auto;
  }
</style>
