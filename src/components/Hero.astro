---
interface HeroItem {
  shortTitle?: string;
  thumbnail?: string;
  heroVideo?: string;
  slug?: string;
}

interface Props {
  items?: HeroItem[];
}

const { items = [] } = Astro.props;
const initialItem = items[0] || {
  shortTitle: "Helping families grow closer to God",
};

const hasMultiple = items.length > 1;
const itemsJson = JSON.stringify(items);
---

<section class="hero section">
  <div id="hero-media-container" class="hero-media-container">
    {initialItem.heroVideo ? (
      <div class="hero-bg-video-wrapper">
        <video 
          id="hero-video-1"
          src={initialItem.heroVideo} 
          class="hero-bg-video active"
          autoplay 
          muted 
          playsinline
          poster={initialItem.thumbnail}
        ></video>
        <video 
          id="hero-video-2"
          class="hero-bg-video"
          muted 
          playsinline
        ></video>
      </div>
    ) : (
      <div 
        id="hero-image"
        class="hero-bg-image" 
        style={`background-image: ${initialItem.thumbnail ? `url(${initialItem.thumbnail})` : 'linear-gradient(135deg, var(--color-bg-secondary) 0%, var(--color-bg-primary) 100%)'};`}
      ></div>
    )}
  </div>
  
  <div class="hero-overlay"></div>
  
  <div class="container hero-container">
    <div class="hero-content animate-fade-in" id="hero-content">
      <h1 id="hero-title" class="hero-title">{initialItem.shortTitle}</h1>
      
      <div class="hero-actions" id="hero-actions">
        {initialItem.slug ? (
          <a id="hero-btn-primary" href={`/songs/${initialItem.slug}`} class="btn btn-primary btn-large">
            <span class="icon-play">▶</span> Watch Now
          </a>
        ) : (
          <a id="hero-btn-primary" href="#resources" class="btn btn-primary btn-large">Explore Resources</a>
        )}
      </div>
    </div>
  </div>
</section>

{hasMultiple && (
  <script is:inline define:vars={{ itemsJson }}>
    document.addEventListener('DOMContentLoaded', () => {
      const items = JSON.parse(itemsJson);
      let currentVideoEl = document.getElementById('hero-video-1');
      let nextVideoEl = document.getElementById('hero-video-2');
      
      if (!currentVideoEl || !nextVideoEl || items.length <= 1) return;

      let currentIndex = 0;

      const titleEl = document.getElementById('hero-title');
      const btnPrimary = document.getElementById('hero-btn-primary');
      const contentEl = document.getElementById('hero-content');

      const handleEnded = () => {
        currentIndex = (currentIndex + 1) % items.length;
        const nextItem = items[currentIndex];

        // Fade out text
        contentEl.style.opacity = '0';
        contentEl.style.transition = 'opacity 0.3s ease';

        setTimeout(() => {
          // Update text content
          if (titleEl) titleEl.textContent = nextItem.shortTitle;
          
          if (btnPrimary && nextItem.slug) {
            btnPrimary.href = `/songs/${nextItem.slug}`;
            btnPrimary.innerHTML = '<span class="icon-play">▶</span> Watch Now';
          }

          // Fade back in
          contentEl.style.opacity = '1';

          // Update video source and play
          if (nextItem.heroVideo) {
            nextVideoEl.src = nextItem.heroVideo;
            
            const playAndSwap = () => {
              nextVideoEl.oncanplay = null;
              nextVideoEl.play().catch(e => console.warn('Autoplay prevented:', e));
              
              nextVideoEl.classList.add('active');
              currentVideoEl.classList.remove('active');
              
              const temp = currentVideoEl;
              currentVideoEl = nextVideoEl;
              nextVideoEl = temp;

              setTimeout(() => {
                nextVideoEl.removeAttribute('src');
                nextVideoEl.load();
              }, 1000);
            };

            if (nextVideoEl.readyState >= 3) {
              playAndSwap();
            } else {
              nextVideoEl.oncanplay = playAndSwap;
              nextVideoEl.load();
            }
          }
        }, 300);
      };

      currentVideoEl.addEventListener('ended', handleEnded);
      nextVideoEl.addEventListener('ended', handleEnded);
    });
  </script>
)}

<style>
  .hero {
    position: relative;
    padding-top: 5rem;
    padding-bottom: 5rem;
    overflow: hidden;
    display: flex;
    align-items: center;
    background-color: var(--color-bg-primary);
    max-height: 600px;
  }
  
  .hero-media-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero-bg-image {
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center 30%;
  }

  .hero-bg-video-wrapper {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: #000;
    position: relative;
  }
  
  .hero-bg-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.8s ease;
    z-index: 0;
  }

  .hero-bg-video.active {
    opacity: 1;
    z-index: 1;
  }
  
  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    /* Subtle gradient overlay for text readability */
    background: linear-gradient(
      to right, 
      rgba(0, 0, 0, 0.6) 0%,
      rgba(0, 0, 0, 0.3) 40%,
      rgba(0, 0, 0, 0) 100%
    );
    z-index: 1;
  }
  
  .hero-container {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: flex-start;
    text-align: left;
    width: 100%;
  }
  
  .hero-content {
    max-width: 700px;
    transition: opacity 0.3s ease;
  }
  
  .hero-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.15;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 4px rgba(0,0,0,0.4);
  }
  
  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: flex-start;
  }
  
  .btn-large {
    padding: 0.875rem 1.75rem;
    font-size: 1.05rem;
  }
  
  .icon-play {
    margin-right: 0.5rem;
    font-size: 0.9em;
  }
  
  @media (max-width: 768px) {
    .hero {
      padding-top: 3rem;
      padding-bottom: 3rem;
      max-height: none;
    }
    
    .hero-overlay {
      /* Stronger gradient on mobile to ensure text readability against video */
      background: linear-gradient(
        to bottom, 
        rgba(0, 0, 0, 0.1) 0%, 
        rgba(0, 0, 0, 0.6) 50%,
        rgba(0, 0, 0, 0.8) 100%
      );
    }
    
    .hero-container {
      text-align: left;
      justify-content: flex-start;
      align-items: flex-end;
      min-height: 50vh; /* Ensure video is prominent on mobile */
    }
    
    .hero-title {
      font-size: 1.75rem;
      margin-bottom: 1rem;
    }
    
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }
    
    .hero-actions .btn {
      width: 100%;
      text-align: center;
      justify-content: center;
    }
  }
</style>
