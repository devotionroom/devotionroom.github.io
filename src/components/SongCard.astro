---
interface Props {
  title: string;
  slug: string;
  bibleReference?: string;
  youtubeId?: string;
  thumbnail?: string;
  category: string;
}

const { title, slug, bibleReference, youtubeId, thumbnail, category } = Astro.props;

// Determine thumbnail URL
const thumbUrl = thumbnail || (youtubeId ? `https://img.youtube.com/vi/${youtubeId}/hqdefault.jpg` : '');
---

<a href={`/songs/${slug}`} class="song-card">
  {thumbUrl && (
    <div class="video-thumbnail">
      <img src={thumbUrl} alt={`${title} thumbnail`} loading="lazy" />
      <div class="play-icon">▶</div>
    </div>
  )}
  <div class="card-content">
    <div class="category-tag">{category}</div>
    <h3 class="card-title">{title}</h3>
    {bibleReference && (
      <div class="card-meta">📖 {bibleReference}</div>
    )}
  </div>
</a>

<style>
  .song-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: all var(--transition-fast);
    overflow: hidden;
    height: 100%;
  }
  
  .song-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-sm);
    border-color: var(--color-accent-primary);
  }
  
  .video-thumbnail {
    width: 100%;
    aspect-ratio: 16/9;
    position: relative;
    background: #000;
    overflow: hidden;
  }
  
  .video-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.8;
    transition: opacity var(--transition-fast);
  }
  
  .song-card:hover .video-thumbnail img {
    opacity: 1;
  }
  
  .play-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 48px;
    height: 48px;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent-primary);
    font-size: 1.25rem;
    box-shadow: var(--shadow-sm);
  }
  
  .card-content {
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  
  .category-tag {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent-primary);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  
  .card-title {
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
    font-size: 1.25rem;
    line-height: 1.3;
  }
  
  .card-meta {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    margin-top: auto;
  }
</style>
