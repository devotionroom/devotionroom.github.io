---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SongCard from '../components/SongCard.astro';
import ContentCard from '../components/ContentCard.astro';
import podcastData from '../data/podcast-episodes.json';
import livestreamsData from '../data/livestreams.json';
import excludedVideos from '../data/excluded-videos.json';

const excludedSet = new Set(excludedVideos.map((v: any) => v.videoId || v));

// Fetch and filter Scripture Songs
const allSongsRaw = await getCollection('songs');
const allSongs = allSongsRaw.filter(song => {
  if (song.data.draft) return false;
  if (song.data.youtubeId && excludedSet.has(song.data.youtubeId)) return false;
  const title = (song.data.title || '').toLowerCase();
  if (title.includes('deleted video') || title.includes('private video')) return false;
  return true;
});
const sortedSongs = allSongs.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Filter Podcasts (excluding any deleted/private/blacklisted entries)
const validPodcasts = podcastData.filter((pod: any) => {
  if (!pod.videoId || excludedSet.has(pod.videoId)) return false;
  const title = (pod.title || '').toLowerCase();
  if (title.includes('deleted video') || title.includes('private video')) return false;
  return true;
});

// Prepare candidate items for the 3 Latest Videos Hero Selection
const songHeroItems = sortedSongs.map(song => ({
  title: song.data.bibleReference ? `${song.data.bibleReference} Song` : song.data.title,
  fullTitle: song.data.title,
  date: song.data.date,
  youtubeId: song.data.youtubeId,
  thumbnail: song.data.thumbnail || (song.data.youtubeId ? `https://img.youtube.com/vi/${song.data.youtubeId}/maxresdefault.jpg` : ''),
  href: `/songs/${song.slug}`,
  category: 'Scripture Song'
}));

const podcastHeroItems = validPodcasts.map((pod: any) => ({
  title: pod.title,
  fullTitle: pod.title,
  date: new Date(pod.publishedAt),
  youtubeId: pod.videoId,
  thumbnail: pod.thumbnail || `https://img.youtube.com/vi/${pod.videoId}/maxresdefault.jpg`,
  href: `https://www.youtube.com/watch?v=${pod.videoId}`,
  category: 'Podcast Episode'
}));

// Combine Scripture Songs and Podcasts, sort newest first, take top 3 (livestreams strictly excluded)
const combinedEligibleVideos = [...songHeroItems, ...podcastHeroItems].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);
const heroItems = combinedEligibleVideos.slice(0, 3);

const featuredSong = sortedSongs[0]; // ONE Latest Scripture Song

// Latest Podcast Episode
const latestPodcast = validPodcasts.length > 0 ? validPodcasts[0] : null;

// Fallback image for Browse card
const browseImage = sortedSongs.length > 1 && (sortedSongs[1].data.thumbnail || (sortedSongs[1].data.youtubeId ? `https://img.youtube.com/vi/${sortedSongs[1].data.youtubeId}/hqdefault.jpg` : '')) || '/images/devotion-room-logo.png';
---

<Layout title="Devotion Room | Scripture Songs & Bible Resources">
  <!-- 1. HERO SECTION -->
  <Hero items={heroItems} />

  <!-- 2. WELCOME TO DEVOTION ROOM (SHORT VERSION) -->
  <section class="section bg-secondary about-section">
    <div class="container text-center max-w-content">
      <h2 class="section-title">Welcome to Devotion Room</h2>
      <p class="about-text">
        We believe God's Word transforms lives. Take a few minutes to pause, reflect, and draw near to God through Scripture Songs and reflections.
      </p>
    </div>
  </section>

  <!-- 3. THREE-COLUMN ROW: Latest Song | Latest Podcast | Browse Songs -->
  <section class="section">
    <div class="container">
      <div class="song-grid">
        
        {/* COLUMN 1 - LATEST SCRIPTURE SONG */}
        <div class="grid-column">
          <h3 class="column-title">New Scripture Song</h3>
          {featuredSong && (
            <SongCard 
              title={featuredSong.data.title}
              slug={featuredSong.slug}
              bibleReference={featuredSong.data.bibleReference}
              youtubeId={featuredSong.data.youtubeId}
              thumbnail={featuredSong.data.thumbnail}
              category={featuredSong.data.category}
              description={featuredSong.data.description}
            />
          )}
        </div>
        
        {/* COLUMN 2 - LATEST PODCAST */}
        <div class="grid-column">
          <h3 class="column-title">New Podcast</h3>
          {latestPodcast && (
            <ContentCard 
              title={latestPodcast.title || "Latest Episode"}
              href={`https://www.youtube.com/watch?v=${latestPodcast.videoId}`}
              thumbnail={latestPodcast.thumbnail || browseImage}
              category="Podcast Episode"
              description={latestPodcast.description ? latestPodcast.description.substring(0, 100) + '...' : "Short reflections on Scripture, followed by Scripture songs."}
              buttonText="Watch on YouTube"
            />
          )}
        </div>
        
        {/* COLUMN 3 - BROWSE LIBRARY */}
        <div class="grid-column">
          <h3 class="column-title">Browse Library</h3>
          <ContentCard 
            title="Explore Collection"
            href="/songs"
            thumbnail={browseImage}
            category="Songs & Podcasts"
            description="Explore our complete collection of Scripture Songs organized by book and theme."
            buttonText="Browse Now"
          />
        </div>
        
      </div>
    </div>
  </section>

  <!-- 4. LATEST LIVESTREAMS (if available) -->
  {livestreamsData.length > 0 && (
    <section class="section bg-secondary">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Latest Livestreams</h2>
        </div>
        <div class="song-grid">
          {livestreamsData.map((stream: any) => (
            <ContentCard 
              title={stream.title}
              href={`https://www.youtube.com/watch?v=${stream.videoId}`}
              thumbnail={stream.thumbnail}
              category="Livestream"
              description={stream.description ? stream.description.substring(0, 100) + '...' : "Join our livestream recording."}
              buttonText="Watch on YouTube"
            />
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>

<style>
  /* General Layout Utilities */
  .text-center {
    text-align: center;
  }
  
  .max-w-content {
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .bg-secondary {
    background-color: var(--color-bg-secondary);
  }
  
  /* Section Spacing Tightening */
  .section {
    padding-top: var(--spacing-xl);
    padding-bottom: var(--spacing-xl);
  }
  
  /* About Section */
  .about-section {
    padding-top: var(--spacing-xl);
    padding-bottom: var(--spacing-lg);
  }
  
  .section-title {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-sm);
  }

  .about-text {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-top: var(--spacing-sm);
    margin-bottom: 0;
  }
  
  /* Grids */
  .song-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--spacing-xl);
  }
  
  .grid-column {
    display: flex;
    flex-direction: column;
  }
  
  .column-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-md) 0;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  /* Responsive Adjustments */
  @media (max-width: 768px) {
    .section-title {
      font-size: 1.75rem;
    }
    
    .column-title {
      font-size: 1.125rem;
    }
  }
</style>
