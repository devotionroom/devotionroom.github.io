---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SongCard from '../components/SongCard.astro';
import ContentCard from '../components/ContentCard.astro';
import Parser from 'rss-parser';

// Fetch Collections
const allSongs = await getCollection('songs');
const sortedSongs = allSongs.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Featured songs for Hero (songs with heroVideo)
const heroVideoSongs = sortedSongs.filter(song => song.data.heroVideo);
const heroItems = heroVideoSongs.length > 0 
  ? heroVideoSongs.map(song => ({
      shortTitle: song.data.bibleReference ? `${song.data.bibleReference} Song` : song.data.title,
      thumbnail: song.data.thumbnail || (song.data.youtubeId ? `https://img.youtube.com/vi/${song.data.youtubeId}/maxresdefault.jpg` : undefined),
      heroVideo: song.data.heroVideo,
      slug: song.slug
    }))
  : sortedSongs.slice(0, 1).map(song => ({
      shortTitle: song.data.bibleReference ? `${song.data.bibleReference} Song` : song.data.title,
      thumbnail: song.data.thumbnail || (song.data.youtubeId ? `https://img.youtube.com/vi/${song.data.youtubeId}/maxresdefault.jpg` : undefined),
      heroVideo: song.data.heroVideo,
      slug: song.slug
    }));

const featuredSong = sortedSongs[0]; // ONE Latest Scripture Song

// Fetch Latest Podcast Episode
let latestPodcast: any = null;
try {
  const parser = new Parser();
  const feed = await parser.parseURL('https://anchor.fm/s/115d910a0/podcast/rss');
  if (feed.items && feed.items.length > 0) {
    latestPodcast = feed.items[0];
  }
} catch (error) {
  console.error("Error fetching podcast RSS:", error);
}

// Fallback image for Browse card
const browseImage = sortedSongs.length > 1 && (sortedSongs[1].data.thumbnail || (sortedSongs[1].data.youtubeId ? `https://img.youtube.com/vi/${sortedSongs[1].data.youtubeId}/hqdefault.jpg` : '')) || '/images/devotion-room-logo.png';
---

<Layout title="Devotion Room | Scripture Songs & Bible Resources">
  <!-- 1. HERO SECTION -->
  <Hero items={heroItems} />

  <!-- 2. WELCOME TO DEVOTION ROOM (SHORT VERSION) -->
  <section class="section bg-secondary about-section">
    <div class="container text-center max-w-content">
      <h2 class="section-title">Welcome to Devotion Room</h2>
      <p class="about-text">
        We believe God's Word transforms lives. Take a few minutes to pause, reflect, and draw near to God through Scripture Songs and reflections.
      </p>
    </div>
  </section>

  <!-- 3. THREE-COLUMN ROW: Latest Song | Latest Podcast | Browse Songs -->
  <section class="section">
    <div class="container">
      <div class="song-grid">
        
        {/* COLUMN 1 - LATEST SCRIPTURE SONG */}
        <div class="grid-column">
          <h3 class="column-title">New Scripture Song</h3>
          {featuredSong && (
            <SongCard 
              title={featuredSong.data.title}
              slug={featuredSong.slug}
              bibleReference={featuredSong.data.bibleReference}
              youtubeId={featuredSong.data.youtubeId}
              thumbnail={featuredSong.data.thumbnail}
              category={featuredSong.data.category}
              description={featuredSong.data.description}
            />
          )}
        </div>
        
        {/* COLUMN 2 - LATEST PODCAST */}
        <div class="grid-column">
          <h3 class="column-title">New Podcast</h3>
          {latestPodcast && (
            <ContentCard 
              title={latestPodcast.title || "Latest Episode"}
              href="/podcast"
              thumbnail={latestPodcast.itunes?.image || browseImage}
              category="Podcast Episode"
              description={latestPodcast.contentSnippet ? latestPodcast.contentSnippet.substring(0, 100) + '...' : "Short reflections on Scripture, followed by Scripture songs."}
              buttonText="Listen Now"
            />
          )}
        </div>
        
        {/* COLUMN 3 - BROWSE SCRIPTURE SONGS */}
        <div class="grid-column">
          <h3 class="column-title">Browse Scripture Songs</h3>
          <ContentCard 
            title="Explore Collection"
            href="/songs"
            thumbnail={browseImage}
            category="All Songs"
            description="Explore our complete collection of Scripture Songs organized by book and theme."
            buttonText="Browse Now"
          />
        </div>
        
      </div>
    </div>
  </section>
</Layout>

<style>
  /* General Layout Utilities */
  .text-center {
    text-align: center;
  }
  
  .max-w-content {
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .bg-secondary {
    background-color: var(--color-bg-secondary);
  }
  
  /* Section Spacing Tightening */
  .section {
    padding-top: var(--spacing-xl);
    padding-bottom: var(--spacing-xl);
  }
  
  /* About Section */
  .about-section {
    padding-top: var(--spacing-xl);
    padding-bottom: var(--spacing-lg);
  }
  
  .section-title {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-sm);
  }

  .about-text {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-top: var(--spacing-sm);
    margin-bottom: 0;
  }
  
  /* Grids */
  .song-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--spacing-xl);
  }
  
  .grid-column {
    display: flex;
    flex-direction: column;
  }
  
  .column-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-md) 0;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  /* Responsive Adjustments */
  @media (max-width: 768px) {
    .section-title {
      font-size: 1.75rem;
    }
    
    .column-title {
      font-size: 1.125rem;
    }
  }
</style>
