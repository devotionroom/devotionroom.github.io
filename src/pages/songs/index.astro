---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SongCard from '../../components/SongCard.astro';

const songs = await getCollection('songs');

// Split songs by featured and latest
const featuredSongs = songs.filter(song => song.data.featured);
const latestSongs = songs
  .filter(song => !song.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6); // show latest 6 non-featured songs

// Get unique categories for the buttons
const categories = [...new Set(songs.map(song => song.data.category))].sort();
---

<Layout title="Scripture Songs">
  <div class="container section">
    <Breadcrumbs items={[{ label: 'Songs', href: '/songs' }]} />
    
    <div class="header-container">
      <h1>Scripture Songs</h1>
      <p class="subtitle">Bible verses brought to life through music.</p>
    </div>

    <!-- Featured Songs Section -->
    {featuredSongs.length > 0 && (
      <section class="content-section">
        <h2 class="section-title">Featured Songs</h2>
        <div class="song-grid">
          {featuredSongs.map(song => (
            <SongCard 
              title={song.data.title}
              slug={song.slug}
              bibleReference={song.data.bibleReference}
              youtubeId={song.data.youtubeId}
              thumbnail={song.data.thumbnail}
              category={song.data.category}
            />
          ))}
        </div>
      </section>
    )}

    <!-- Latest Releases Section -->
    {latestSongs.length > 0 && (
      <section class="content-section">
        <h2 class="section-title">Latest Releases</h2>
        <div class="song-grid">
          {latestSongs.map(song => (
            <SongCard 
              title={song.data.title}
              slug={song.slug}
              bibleReference={song.data.bibleReference}
              youtubeId={song.data.youtubeId}
              thumbnail={song.data.thumbnail}
              category={song.data.category}
            />
          ))}
        </div>
      </section>
    )}

    <!-- Browse by Category Section -->
    <section class="category-section">
      <h2>Browse by Category</h2>
      <div class="category-grid">
        {categories.map(category => {
          // Count songs in this category
          const count = songs.filter(s => s.data.category === category).length;
          return (
            <a href={`/songs/category/${category.toLowerCase().replace(/\s+/g, '-')}`} class="category-button">
              <span class="category-name">{category}</span>
              <span class="category-count">{count} {count === 1 ? 'Song' : 'Songs'}</span>
            </a>
          );
        })}
      </div>
    </section>
  </div>
</Layout>

<style>
  .header-container {
    text-align: center;
    margin-bottom: var(--spacing-xl);
  }
  
  .header-container h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }
  
  .subtitle {
    color: var(--color-text-secondary);
    font-size: 1.125rem;
  }
  
  /* Category Buttons */
  .category-section {
    margin-bottom: var(--spacing-xxl);
    padding: var(--spacing-lg);
    background: var(--color-bg-secondary);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .category-section h2 {
    font-size: 1.5rem;
    margin-bottom: var(--spacing-md);
  }

  .category-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .category-button {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 1rem 1.5rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    min-width: 150px;
    transition: all var(--transition-fast);
  }

  .category-button:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
    border-color: var(--color-accent-primary);
  }

  .category-name {
    color: var(--color-text-primary);
    font-weight: 600;
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
  }

  .category-count {
    color: var(--color-text-secondary);
    font-size: 0.85rem;
  }

  /* Song Grids */
  .content-section {
    margin-bottom: var(--spacing-xxl);
  }

  .section-title {
    font-size: 2rem;
    margin-bottom: var(--spacing-lg);
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-bg-secondary);
  }
  
  .song-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--spacing-lg);
  }
</style>
